# Environment Variables
GEMINI_API_KEY=your-gemini-api-key
ELEVENLABS_API_KEY=sk_your-elevenlabs-key
PEXELS_API_KEY=your-pexels-api-key

# YouTube OAuth (run: npm run get-yt-token)
YT_CLIENT_ID=your-client-id
YT_CLIENT_SECRET=your-client-secret
YT_REDIRECT_URI=http://localhost:5000/oauth2callback
YT_REFRESH_TOKEN=your-refresh-token
YT_CHANNEL_ID=your-channel-id-here

# Instagram (optional — leave blank to skip)
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# Pipeline settings
DAILY_UPLOAD_LIMIT=1
